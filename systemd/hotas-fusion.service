[Unit]
Description=HOTAS Fusion virtual combined joystick
After=systemd-udevd.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/hotas-fusion
ExecStart=/opt/hotas-fusion/.venv/bin/python -u /opt/hotas-fusion/hotas_fusion.py --wait
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
